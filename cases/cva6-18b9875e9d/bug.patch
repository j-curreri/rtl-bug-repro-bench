     logic [CVA6Cfg.ASID_WIDTH-1:0] asid;
@@ -228,10 +229,10 @@ module cva6_tlb
             lu_gpaddr_o = {content_q[i].pte.ppn[(CVA6Cfg.GPPNW-1):0], lu_vaddr_i[11:0]};
             // S-stage Mega page
             if (tags_q[i].is_page[1][0])
